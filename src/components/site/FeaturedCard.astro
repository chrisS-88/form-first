---
const {
  image = null,
  label = null,
  title,
  description = null,
  cta = null,
  variant = "image", // "image" | "solid"
  color = "bg-brand-800", // used for solid variant
} = Astro.props;
---

<div class={`relative h-full overflow-hidden group rounded-lg ${variant === "solid" ? `${color} text-brand-900` : "bg-brand-800"}`}>
  {
    variant === "image" && image && (
      <div
        class="absolute inset-0 bg-cover bg-center grayscale-[40%] group-hover:grayscale-0 transition"
        style={`background-image: url('${image}')`}
      />
    )
  }

  <!-- Content overlay -->
  <div class={`relative h-full overflow-hidden group rounded-lg ${variant === "solid" ? `${color} text-brand-900` : "bg-brand-800"}`}>
    <!-- Background image -->
    {
      variant === "image" && image && (
        <div
          class="absolute inset-0 bg-cover bg-center grayscale-[40%] group-hover:grayscale-0 transition"
          style={`background-image: url('${image}')`}
        />
      )
    }

    <!-- Overlay (between image + content) -->
    {variant === "image" && <div class="absolute inset-0 bg-black/40 group-hover:bg-black/30 transition" />}

    <!-- Content -->
    <div class="relative h-full p-8 z-10 flex flex-col justify-end items-start">
      {label && <p class="text-secondary text-sm font-semibold tracking-wide mb-2">{label}</p>}

      <h3 class="font-heading font-extrabold text-3xl leading-tight">
        {title}
      </h3>

      {description && <p class={`mt-3 ${variant === "solid" ? "text-brand-900" : "text-brand-200"}`}>{description}</p>}

      <div class="mt-6">
        <slot name="action">
          {cta && <button class="font-semibold tracking-wide hover:text-primary">{cta}</button>}
        </slot>
      </div>
    </div>
  </div>
</div>
