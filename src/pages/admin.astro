---
import AdminTable from "../components/booking/AdminTable.jsx";
import MinimalLayout from "../layouts/MinimalLayout.astro";
---

<MinimalLayout>
  <div class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="font-heading text-3xl font-bold text-brand-50 mb-4">Admin</h1>

    <p class="text-brand-300 mb-10 max-w-md">
      A simple overview of all bookings in the system. This is a demo-only admin view using mock data.
    </p>

    <div class="overflow-x-auto rounded-lg border border-brand-800">
      <AdminTable client:load />
    </div>
  </div>
</MinimalLayout>
